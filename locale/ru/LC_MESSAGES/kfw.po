msgstr "На счету {name} столько нокаутов, что и не сосчитать."

#: kf_lib/happenings/encounters/_rumors.py:129
msgid "{name} has lots of friends — {n} at my last count. Don't pick a fight with that one."
msgstr "У {name} куча друзей — по последним подсчётам, {n}. С этим бойцом лучше не связываться."

#: kf_lib/actors/player/_base_player.py:205
