msgstr "{name} теперь номер {rank} в своей школе."

#: kf_lib/happenings/encounters/_rumors.py:162
msgid "{name} is nursing an injury. A good time to get ahead!"
msgstr "{name} сейчас лечит травму. Самое время вырваться вперёд!"

#: kf_lib/actors/fighter/_strike_mechanics.py:180
msgid "{name} is off-balance!"
msgstr "{name} теряет равновесие!"

#: kf_lib/actors/human_controlled_fighter.py:272
msgid ""
"{name} is practicing in the school's courtyard when {master} calls him to the main hall.\n"
"{master}: \"{name}, you have been most diligent. Few students go as far as you have, so today I can trust you with the inner teaching of our school. The style the outside world knows as {public_style} has a true name, whispered only to the most trusted disciples: {style}! And with it comes the secret technique — {tech}. Guard this knowledge, and never speak of it outside these walls.\""
msgstr ""
"{name} тренируется во дворе школы, когда {master} зовёт в главный зал.\n"
"{master}: \"{name}, ты был очень прилежен. Немногие ученики заходят так далеко, как ты, поэтому сегодня я могу доверить тебе внутреннее учение нашей школы. У стиля, который внешний мир знает как {public_style}, есть истинное имя, которое шепотом передают лишь самым доверенным ученикам: {style}! А вместе с ним — секретная техника: {tech}. Береги это знание и не говори о нём никому за этими стенами.\""

#: kf_lib/actors/human_controlled_fighter.py:290
msgid ""
"{name} is practicing in the school's courtyard when {master} calls him to the main hall.\n"
"{master}: \"{name}, you have been most diligent. Few students go as far as you have. It is time you learned the secret technique of {style} — {tech}. Guard this knowledge, and never speak of it outside these walls.\""
msgstr ""
"{name} тренируется во дворе школы, когда {master} зовёт в главный зал.\n"
"{master}: \"{name}, ты был очень прилежен. Немногие ученики заходят так далеко, как ты. Пришло время узнать секретную технику стиля {style} — {tech}. Береги это знание и не говори о нём никому за этими стенами.\""

#: kf_lib/happenings/encounters/_rumors.py:167
msgid "{name} is sick in bed, poor thing."
msgstr "У {name} хворь, лежит в постели. Бедняжка."

#: kf_lib/happenings/story/_grand_melee.py:157
msgid "{name} is the last one standing again! Easy money!"
msgstr "{name} снова остаётся последним на ногах! Лёгкие деньги!"

#: kf_lib/happenings/story/_grand_melee.py:110
msgid "{name} is the last one standing! The crowd goes wild!"
msgstr "На ногах остаётся только {name}! Толпа ликует!"

#: kf_lib/actors/player/_base_player.py:766
msgid "{name} is {status} and needs {days} day to recover."
msgid_plural "{name} is {status} and needs {days} days to recover."
msgstr[0] "{name}: {status}. Для восстановления нужен {days} день."
msgstr[1] "{name}: {status}. Для восстановления нужно {days} дня."
msgstr[2] "{name}: {status}. Для восстановления нужно {days} дней."

#: kf_lib/happenings/encounters/_rumors.py:186
