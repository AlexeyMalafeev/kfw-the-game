#: kf_lib/happenings/encounters/_craftsman.py:22
msgid ""
"{name} meets a craftsman.\n"
"Craftsman: \"Ah, a martial artist! You're in luck! I'm selling this excellent {item} ({descr}). It's only {price} coins! Don't worry, if you don't have enough money right now, you can pay the rest later. Will you buy it?\""
msgstr ""
"{name} встречает ремесленника.\n"
"Ремесленник: \"А, мастер боевых искусств! Вам повезло! Продаю отличный товар: {item} ({descr}). Всего {price} монет! Не беспокойтесь, если сейчас не хватает денег, — остаток доплатите позже. Берёте?\""

#: kf_lib/happenings/encounters/_people.py:320
#~ msgid "{name} meets a local gossipmonger. Pay {n} coin to hear the latest rumors?"
#~ msgid_plural "{name} meets a local gossipmonger. Pay {n} coins to hear the latest rumors?"
#~ msgstr[0] "{name} встречает местного сплетника. Заплатить {n} монета, чтобы услышать свежие слухи?"
