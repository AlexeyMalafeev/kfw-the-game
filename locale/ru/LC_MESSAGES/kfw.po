#: kf_lib/happenings/story/_wrong_pouch.py:79
msgid "{name} climbs out of the pile of bodies, pockets {n} coin (\"EXACTLY mine, I counted\"), and also grabs {item} from the table. Finders keepers!"
msgid_plural "{name} climbs out of the pile of bodies, pockets {n} coins (\"EXACTLY mine, I counted\"), and also grabs {item} from the table. Finders keepers!"
msgstr[0] "{name} выбирается из груды тел, прикарманивает {n} монету (\"РОВНО моя, я считал\"), а также прибирает к рукам предмет: {item}. Кто нашёл — того и вещь!"
msgstr[1] "{name} выбирается из груды тел, прикарманивает {n} монеты (\"РОВНО мои, я считал\"), а также прибирает к рукам предмет: {item}. Кто нашёл — того и вещь!"
msgstr[2] "{name} выбирается из груды тел, прикарманивает {n} монет (\"РОВНО мои, я считал\"), а также прибирает к рукам предмет: {item}. Кто нашёл — того и вещь!"

#: kf_lib/happenings/encounters/_performer.py:156
