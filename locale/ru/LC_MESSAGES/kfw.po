msgid_plural "{} encounters {} robbers."
msgstr[0] "{} встречает {} разбойника."
msgstr[1] "{} встречает {} разбойника."
msgstr[2] "{} встречает {} разбойников."

msgid "{} fails to escape and gets a beating."
msgstr "{} не удаётся сбежать, и его избивают."

msgid "{} feels too greedy!"
msgstr "{} чувствует себя слишком жадным!"

msgid "{} feels too scared to fight!"
msgstr "{} слишком напуган, чтобы драться!"

msgid "{} grabs the thief by the arm, but the thief fights back."
msgstr "{} хватает вора за руку, но вор оказывает сопротивление."

msgid "{} is ambushed by a strange fat girl."
msgstr "{} попадает в засаду странной толстой девицы."

msgid "{} is out of students and leaves the tournament!"
msgstr "В школе {} не осталось учеников — школа выбывает из турнира!"

msgid "{} is stolen by a thief."
msgstr "Вор крадёт: {}."

msgid "{} is the last one standing!"
msgstr "{} последним остаётся на ногах!"

msgid "{} joins the fight on {}'s side."
msgid_plural "{} join the fight on {}'s side."
msgstr[0] "{} вступает в бой на стороне {}."
msgstr[1] "{} вступают в бой на стороне {}."
msgstr[2] "{} вступают в бой на стороне {}."

msgid "{} joins {}'s training session."
msgid_plural "{} join {}'s training session."
msgstr[0] "{} присоединяется к тренировке {}."
msgstr[1] "{} присоединяются к тренировке {}."
msgstr[2] "{} присоединяются к тренировке {}."

msgid "{} made great progress!"
msgstr "{} добился больших успехов!"

msgid "{} manages to get away."
msgstr "{} удаётся ускользнуть."

msgid "{} meets a beggar."
msgstr "{} встречает нищего."

msgid "{} meets a drunkard. \"Hey, pal, come drink with me!\" he slurs."
msgstr "{} встречает пьяницу. \"Эй, приятель, пойдём выпьем!\" — бормочет он."

msgid "{} meets a shady character who offers to participate in an underground prize fighting contest. \"It's simple. You pay {} coin to enter. There are five stages in the contest. The more opponents you beat, the more money you win. How does that sound?\""
msgid_plural "{} meets a shady character who offers to participate in an underground prize fighting contest. \"It's simple. You pay {} coins to enter. There are five stages in the contest. The more opponents you beat, the more money you win. How does that sound?\""
msgstr[0] "{} встречает подозрительного типа, который предлагает поучаствовать в подпольном бойцовском турнире. \"Всё просто. Вы платите {} монету за вход. В турнире пять этапов. Чем больше противников победите, тем больше денег выиграете. Как вам такое предложение?\""
msgstr[1] "{} встречает подозрительного типа, который предлагает поучаствовать в подпольном бойцовском турнире. \"Всё просто. Вы платите {} монеты за вход. В турнире пять этапов. Чем больше противников победите, тем больше денег выиграете. Как вам такое предложение?\""
msgstr[2] "{} встречает подозрительного типа, который предлагает поучаствовать в подпольном бойцовском турнире. \"Всё просто. Вы платите {} монет за вход. В турнире пять этапов. Чем больше противников победите, тем больше денег выиграете. Как вам такое предложение?\""

msgid "{} meets a wise man."
msgstr "{} встречает мудреца."

msgid "{} politely says goodbye and walks away."
msgstr "{} вежливо прощается и уходит."

msgid "{} refuses to drink."
msgstr "{} отказывается пить."

msgid "{} refuses to gamble."
msgstr "{} отказывается от азартной игры."

msgid "{} represents the school at the tournament."
msgstr "{} представляет школу на турнире."

msgid "{} runs away in fear."
msgstr "{} в страхе убегает."

msgid "{} school wins!"
msgstr "Школа {} побеждает!"

msgid "{} sees {} man robbing someone."
msgid_plural "{} sees {} men robbing someone."
msgstr[0] "{} видит, как {} человек кого-то грабит."
msgstr[1] "{} видит, как {} человека кого-то грабят."
msgstr[2] "{} видит, как {} человек кого-то грабят."

msgid "{} takes the criminal to the police."
msgstr "{} отводит преступника в полицию."

msgid "{} thug attacks the master."
msgid_plural "{} thugs attack the master."
msgstr[0] "{} головорез нападает на мастера."
msgstr[1] "{} головореза нападают на мастера."
msgstr[2] "{} головорезов нападают на мастера."

msgid "{} tries to stop him, but the pickpocket quickly disappears in the crowd."
msgstr "{} пытается остановить его, но карманник быстро исчезает в толпе."

msgid "{} wins the tournament!"
msgstr "{} побеждает в турнире!"

msgid "{} wins!"
msgstr "{} побеждает!"

msgid "{}'s school wins the All-Schools Tournament!"
msgstr "Школа {} побеждает в Турнире всех школ!"

msgid "{}:"
msgstr "{}:"

msgid "{}: \"A fist fight carries no weight. Let's duel with blades.\""
msgstr "{}: \"Кулачный бой ничего не значит. Будем драться на клинках.\""

msgid "{}: \"Can't stop me, can you? Ha-ha-ha!\""
msgstr "{}: \"Не остановить меня, а? Ха-ха-ха!\""

msgid "{}: \"I shouldn't have been provoked so easily...\""
msgstr "{}: \"Мне не следовало так легко поддаваться на провокации...\""

msgid "{}: \"Now let's go to the police...\""
msgstr "{}: \"А теперь пойдём в полицию...\""

msgid "{}: \"Thank you very much!!!\""
msgstr "{}: \"Большое спасибо!!!\""

msgid ""
"{}: \"That was a good fight!\n"
"Let's be friends!\""
msgstr ""
"{}: \"Это был хороший бой!\n"
"Давайте будем друзьями!\""

msgid "{}: \"That was a good match! Let's do it again some time.\""
msgstr "{}: \"Отличный был поединок! Давай как-нибудь повторим.\""

msgid "{}: \"What amazing kung-fu! Even though I lost, I feel that my technique has improved\""
