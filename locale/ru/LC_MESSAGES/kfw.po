msgstr[1] "На счету {name} уже {n} победы на турнирах. Настоящий чемпион!"
msgstr[2] "На счету {name} уже {n} побед на турнирах. Настоящий чемпион!"

#: kf_lib/happenings/encounters/_rumors.py:180
msgid "{name} is a regular at the tavern. Too regular, if you ask me."
msgstr "{name} — завсегдатай таверны. Слишком уж частый, если хочешь знать моё мнение."

#: kf_lib/happenings/encounters/_ambush.py:31
msgid ""
"{name} is ambushed by his enemy {enemy} with {n} thug!!\n"
"{enemy}: \"Seize this fellow and give him a good beating!\""
msgid_plural ""
"{name} is ambushed by his enemy {enemy} with {n} thugs!!\n"
"{enemy}: \"Seize this fellow and give him a good beating!\""
msgstr[0] ""
"На {name} нападает его враг {enemy} — а с ним {n} головорез!!\n"
"{enemy}: \"Хватайте этого типа и задайте ему хорошую трёпку!\""
msgstr[1] ""
"На {name} нападает его враг {enemy} — а с ним {n} головореза!!\n"
"{enemy}: \"Хватайте этого типа и задайте ему хорошую трёпку!\""
msgstr[2] ""
"На {name} нападает его враг {enemy} — а с ним {n} головорезов!!\n"
"{enemy}: \"Хватайте этого типа и задайте ему хорошую трёпку!\""

#: kf_lib/actors/player/_base_player.py:1112
msgid "{name} is no longer {trait}."
msgstr "{name} больше не {trait}."

#: kf_lib/game/_base_game.py:134
