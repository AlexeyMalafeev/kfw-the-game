#: kf_lib/happenings/encounters/_school.py:225
msgid "{m_name}: \"Well done, {p_name}. You are now the best student of our school. You make me proud — but remember, there is always more to learn.\""
msgstr "{m_name}: \"Молодец, {p_name}. Теперь ты лучший ученик нашей школы. Я горжусь тобой — но помни: всегда есть чему учиться.\""

#: kf_lib/happenings/encounters/_school.py:214
