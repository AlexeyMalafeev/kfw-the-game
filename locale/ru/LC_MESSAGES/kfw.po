msgid ""
"{player} meets {opp} (lv.{lv}).\n"
"{opp}: \"Let's have a friendly match!\""
msgstr ""
"{player} встречает {opp} (ур.{lv}).\n"
"{opp}: \"Давай проведём дружеский поединок!\""

#: kf_lib/happenings/encounters/_people.py:302
msgid "{player}'s friend {opp} challenges him to a friendly match."
msgstr "Друг {player} ({opp}) вызывает его на товарищеский бой."

#: kf_lib/happenings/encounters/_romance.py:131
msgid ""
"{r_name} blocks {p_name}'s way.\n"
"{r_name}: \"Stay away from {sw_name}! {sw_name} is mine! Let's settle this like martial artists!\""
msgstr ""
"{r_name} преграждает путь {p_name}.\n"
"{r_name}: \"Держись подальше от {sw_name}! {sw_name} принадлежит мне! Решим это как мастера единоборств!\""

#: kf_lib/happenings/encounters/_romance.py:178
msgid "{r_name}: \"Ha! And you call yourself a martial artist? Stay away from {sw_name}!\""
msgstr "{r_name}: \"Ха! И ты называешь себя мастером боевых искусств? Держись подальше от {sw_name}!\""

